<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.LoginViewController"
      styleClass="root-container">
    
    <!-- Panel Izquierdo - Decorativo -->
    <VBox styleClass="left-panel" 
          alignment="CENTER" 
          HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>
        
        <Label text="Bienvenido a TaskLink" styleClass="welcome-title"/>
        <Label text="Gestor de Tareas" styleClass="welcome-subtitle"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Organiza tu vida de manera simple" styleClass="welcome-description"/>
    </VBox>
    
    <!-- Panel Derecho - Formulario de Login -->
    <VBox styleClass="right-panel" 
          alignment="CENTER" 
          spacing="25"
          HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>
        
        <!-- Contenedor del formulario -->
        <VBox styleClass="form-container" 
              spacing="20" 
              alignment="TOP_CENTER"
              maxWidth="400">
            
            <!-- Título -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="Iniciar Sesión" styleClass="form-title"/>
                <Label text="Ingresa tus credenciales para continuar" styleClass="form-subtitle"/>
            </VBox>
            
            <!-- Mensaje de error/éxito -->
            <Label fx:id="errorLabel" 
                   styleClass="error-label" 
                   wrapText="true"
                   maxWidth="Infinity"/>
            
            <!-- Campo Usuario -->
            <VBox spacing="8">
                <Label text="Usuario" styleClass="field-label"/>
                <TextField fx:id="usernameField" 
                          promptText="Ingresa tu usuario"
                          styleClass="input-field"/>
            </VBox>
            
            <!-- Campo Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" 
                              promptText="Ingresa tu contraseña"
                              styleClass="input-field"/>
            </VBox>
            
            <!-- Botón Login -->
            <Button fx:id="loginButton" 
                   text="Iniciar Sesión" 
                   styleClass="login-button"
                   maxWidth="Infinity"/>
            
            <!-- Separador -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="o" styleClass="separator-text"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Registro -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="¿No tienes cuenta?" styleClass="register-text"/>
                <Hyperlink fx:id="registerLink" 
                          text="Regístrate aquí"
                          styleClass="link-primary"/>
            </HBox>
            
        </VBox>
    </VBox>
</HBox>