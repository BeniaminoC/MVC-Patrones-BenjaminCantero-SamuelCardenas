<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.RegisterViewController"
      styleClass="root-container">
    
    <!-- Panel Izquierdo - Decorativo -->
    <VBox styleClass="left-panel" 
          alignment="CENTER" 
          HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>
        
        <Label text="Únete a Nosotros" styleClass="welcome-title"/>
        <Label text="Gestor de Tareas" styleClass="welcome-subtitle"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Crea tu cuenta y comienza a organizar tu vida" styleClass="welcome-description"/>
    </VBox>
    
    <!-- Panel Derecho - Formulario de Registro -->
    <VBox styleClass="right-panel" 
          alignment="CENTER" 
          spacing="15"
          HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="10" right="50" bottom="100" left="50"/>
        </padding>
        
        <!-- Contenedor del formulario -->
        <VBox styleClass="form-container" 
              spacing="12" 
              alignment="TOP_CENTER"
              maxWidth="400">
            
            <!-- Título -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="Crear Cuenta" styleClass="form-title"/>
                <Label text="Completa tus datos para registrarte" styleClass="form-subtitle"/>
            </VBox>
            
            <!-- Mensaje de error/éxito -->
            <Label fx:id="messageLabel" 
                   styleClass="message-label" 
                   wrapText="true"
                   maxWidth="Infinity"/>
            
            <!-- Campo Usuario -->
            <VBox spacing="8">
                <Label text="Usuario" styleClass="field-label"/>
                <TextField fx:id="usernameField" 
                          promptText="Elige un nombre de usuario"
                          styleClass="input-field"/>
            </VBox>
            
            <!-- Campo Email -->
            <VBox spacing="8">
                <Label text="Correo Electrónico" styleClass="field-label"/>
                <TextField fx:id="emailField" 
                          promptText="ejemplo@correo.com"
                          styleClass="input-field"/>
            </VBox>
            
            <!-- Campo Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" 
                              promptText="Mínimo 6 caracteres"
                              styleClass="input-field"/>
            </VBox>
            
            <!-- Campo Confirmar Contraseña -->
            <VBox spacing="8">
                <Label text="Confirmar Contraseña" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" 
                              promptText="Repite tu contraseña"
                              styleClass="input-field"/>
            </VBox>
            
            <!-- Botón Registro -->
            <Button fx:id="registerButton" 
                   text="Registrarse" 
                   styleClass="register-button"
                   maxWidth="Infinity"/>
            
            <!-- Separador -->
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="o" styleClass="separator-text"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Login -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="¿Ya tienes cuenta?" styleClass="login-text"/>
                <Hyperlink fx:id="loginLink" 
                          text="Inicia sesión aquí"
                          styleClass="link-primary"/>
            </HBox>
            
        </VBox>
    </VBox>
</HBox>
