<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.MainViewController"
      styleClass="root-container"
      alignment="TOP_CENTER"
      spacing="20">
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <!-- Contenedor principal con ancho máximo -->
    <VBox styleClass="main-container" spacing="20" alignment="TOP_CENTER">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="Mis Tareas" styleClass="title"/>
            <Label fx:id="statsLabel" text="0 tareas pendientes" styleClass="stats-label"/>
        </VBox>
        
        <!-- Input Card -->
        <HBox styleClass="input-card" spacing="10" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <TextField fx:id="inputField" 
                      promptText="Añadir una nueva tarea..."
                      styleClass="input-field"
                      HBox.hgrow="ALWAYS"/>
            
            <Button fx:id="addButton" 
                   text="Añadir" 
                   styleClass="add-button"/>
        </HBox>
        
        <!-- Task List Area -->
        <ScrollPane fitToWidth="true" 
                   styleClass="scroll-pane"
                   VBox.vgrow="ALWAYS">
            <VBox spacing="10">
                <!-- Empty State -->
                <VBox fx:id="emptyStateBox" 
                     styleClass="empty-state" 
                     alignment="CENTER" 
                     spacing="10">
                    <padding>
                        <Insets top="50" right="50" bottom="50" left="50"/>
                    </padding>
                    <Label text="○" styleClass="empty-icon"/>
                    <Label text="No hay tareas aún" styleClass="empty-text"/>
                    <Label text="¡Añade tu primera tarea para comenzar!" styleClass="empty-subtext"/>
                </VBox>
                
                <!-- Task List Container -->
                <VBox fx:id="taskListContainer" spacing="10"/>
            </VBox>
        </ScrollPane>
        
    </VBox>
</VBox>
